<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Your Company</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
<header>
    <nav class="navbar">
        <div class="logo">📊 Manage Your Company</div>

        <ul class="nav-links">
            <li><a href="/Home/Index">Home</a></li>
            <li><a href="/Employee/GoEmployeePage">Employees</a></li>
            <li><a href="/Project/GoProjectPage">Projects</a></li>
            <li><a href="/Department/GoDepartmentPage">Departments</a></li>
        </ul>
    </nav>
</header>
<div class="project-page">
    <div class="page-header">

        <h1>Projects Management</h1>

    </div>

    <div class="project-container">

        @foreach (var project in Model)
        {
            <div class="project-card">
                <div class="project-icon">
                    📊
                </div>

                <h2>@project.Name</h2>

                <p>
                    <strong>ID :</strong>
                    @project.Id
                </p>

                <p>
                    <strong>Type :</strong>
                    @project.Type
                </p>

                <div class="card-actions">

                    <a href="/Project/EditProject/@project.Id"
                           class="edit-btn">
                        Edit
                    </a>

                    <a href="/Project/DeleteProject/@project.Id"
                           class="delete-btn">
                        Delete
                    </a>

                    <a href="/Project/ShowEmployees/@project.Id"
                            class="show-btn">
                        Show Employees
                    </a>
               
                </div>

            </div>
        }

    </div>
</div>
<style>
    .navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 25px 10%;
        background: white;
        box-shadow: 0 4px 20px rgba(0,0,0,.08);
        position: sticky;
        top: 0;
    }

    .logo {
        font-size: 28px;
        font-weight: 700;
        color: #2563EB;
    }

    .nav-links {
        display: flex;
        gap: 25px;
        list-style: none;
    }

    .nav-links a {
        text-decoration: none;
        color: #334155;
        font-weight: 500;
        transition: .3s;
    }

    .nav-links a:hover {
        color: #2563EB;
    }

    .project-page {
        width: 90%;
        margin: 40px auto;
    }

    .add-btn {
        text-decoration: none;
        background: #2563eb;
        color: white;
        padding: 14px 24px;
        border-radius: 12px;
        font-weight: bold;
        transition: .3s;
    }

    .add-btn:hover {
        background: #1d4ed8;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }
    .project-container {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(320px,1fr));
        gap: 25px;
        margin-top: 30px;
    }

    .project-card {
        background: white;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,.08);
        transition: .3s;
        text-align: center;
    }

    .project-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 30px rgba(37,99,235,.15);
    }

    .project-icon {
        font-size: 60px;
        margin-bottom: 20px;
    }

    .project-card h2 {
        color: #0f172a;
        margin-bottom: 20px;
    }

    .project-card p {
        color: #475569;
        margin-bottom: 10px;
        font-size: 15px;
    }

    .card-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 25px;
    }

    .card-actions a {
        text-decoration: none;
        color: white;
        padding: 10px 18px;
        border-radius: 10px;
        font-size: 14px;
        transition: .3s;
    }

    .edit-btn {
        background: #10b981;
    }

    .edit-btn:hover {
        background: #059669;
    }

    .delete-btn {
        background: #ef4444;
    }

    .delete-btn:hover {
        background: #dc2626;
    }

    .show-btn {
        background: #2563eb;
    }

    .show-btn:hover {
        background: #1d4ed8;
    }
</style>
</body>
</html>